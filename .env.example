# Copy to .env in the repository root. .env is gitignored.
# Never commit passwords or session ids.

IDMC_LOGIN_URL=https://dm-eu.informaticacloud.com
IDMC_USERNAME=
IDMC_PASSWORD=

# mock (default) or live. mock ignores the credentials above.
IDMC_BACKEND=mock

# Optional Business 360 export directory or zip. Default is mock/idmc-export/person.
# IDMC_MODEL_EXPORT=

# Optional file of redacted HTTP bodies. Session ids and passwords are stripped.
# IDMC_DEBUG_DUMP=
